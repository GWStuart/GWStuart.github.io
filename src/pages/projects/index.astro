---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects, groupByYear } from '../../lib/content';

const projects = await getProjects();
---

<Base title="Projects" description="Programming projects by George Stuart, newest first.">
  <h1>Projects</h1>
  <p class="tagline">Things I've built, newest first.</p>

  <div class="section">
    {
      groupByYear(projects).map(([year, items]) => (
        <section class="year-group">
          <h2 class="year-heading">{year}</h2>
          <ProjectList projects={items} showYear={false} />
        </section>
      ))
    }
  </div>
</Base>
