---
import { site } from '../site.config';
import { notePdfUrl, noteSourceUrl, semesterLabel, type Note } from '../lib/content';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
// Note PDFs open in a new tab, so the notes list stays open behind them.
---

<ul class="item-list">
  {
    notes.map((note) => {
      const { title, course, year, semester, summary, draft } = note.data;
      const source = noteSourceUrl(note, site.repo);
      const when = [semesterLabel(semester), year].filter(Boolean).join(' ');
      return (
        <li class="note-item">
          <div class="item-heading">
            <h3>
              <a href={notePdfUrl(note)} target="_blank" rel="noopener">{course ? `${course}: ${title}` : title}</a>
              {draft && <span class="badge">Draft</span>}
            </h3>
            <span class="meta">{when}</span>
          </div>
          <div class="item-body">
            {summary && <p class="summary">{summary}</p>}
            <ul class="inline-list meta">
              <li>
                <a href={notePdfUrl(note)} target="_blank" rel="noopener">PDF</a>
              </li>
              {source && (
                <li>
                  <a href={source}>LaTeX source</a>
                </li>
              )}
            </ul>
          </div>
        </li>
      );
    })
  }
</ul>
